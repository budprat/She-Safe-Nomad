# Supabase Configuration
# Get these values from your Supabase project settings
# https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_PROJECT_ID=your_project_id_here
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key_here

# Mapbox Configuration
# Get your public token from https://account.mapbox.com/access-tokens/
# This is safe to expose in frontend code (public token only)
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here

# ============================================================================
# SUPABASE EDGE FUNCTION SECRETS (Set in Supabase Dashboard)
# These are NOT exposed to the frontend - only used by Edge Functions
# Set these in: Supabase Dashboard > Project Settings > Edge Functions > Secrets
# ============================================================================

# Twilio SMS Configuration (for SOS notifications)
# Get credentials from https://console.twilio.com/
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# SendGrid Email Configuration (for SOS notifications)
# Get API key from https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=your_sendgrid_api_key
# FROM_EMAIL=alerts@yourdomain.com

# Stripe Payment Configuration (for premium subscriptions)
# Get keys from https://dashboard.stripe.com/apikeys
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxx (safe for frontend)
# STRIPE_SECRET_KEY=sk_live_xxx (Edge Functions only)
# STRIPE_WEBHOOK_SECRET=whsec_xxx (Edge Functions only)
